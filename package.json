{
  "name": "nimbuspact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:lint": "python -X utf8 -m genvm_linter.cli check contracts/nimbuspact.py",
    "test": "python -m pytest tests/direct -v",
    "test:frontend": "node --experimental-strip-types tests/frontend/receipt_status.test.mjs",
    "test:integration": "gltest tests/integration/ -v -s",
    "frontend:typecheck": "npm --prefix app run typecheck",
    "frontend:build": "npm --prefix app run build",
    "check": "npm run contract:lint && npm run test && npm run test:frontend && npm run frontend:typecheck && npm run frontend:build"
  },
  "devDependencies": {
    "genlayer-js": "^1.1.8"
  }
}
